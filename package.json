{
  "name": "leaflet-hotline",
  "version": "0.4.0",
  "description": "A Leaflet plugin for drawing colored gradients along a polyline",
  "type": "module",
  "exports": {
    "import": "./dist/leaflet.hotline.js"
  },
  "scripts": {
    "test": "npm run lint",
    "lint": "eslint src/leaflet.hotline.js",
    "clean-linux": "rm -rf dist",
    "clean": "rmdir /s /q dist",
    "prebuild-linux": "npm run clean && mkdir -p dist",
    "prebuild": "npm run clean && if not exist dist mkdir dist",
    "build": "npm run test && rollup -c",
    "dev": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/iosphere/Leaflet.hotline.git"
  },
  "keywords": [
    "Leaflet",
    "plugin",
    "canvas",
    "visualization",
    "path",
    "gradient",
    "heatmap",
    "color",
    "colour"
  ],
  "author": "Jonas Coch",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/iosphere/Leaflet.hotline/issues"
  },
  "homepage": "https://iosphere.github.io/Leaflet.hotline/demo/",
  "devDependencies": {
    "eslint": "^9.31.0",
    "rollup": "^2.79.2",
    "rollup-plugin-terser": "^7.0.2"
  },
  "peerDependencies": {
    "leaflet": "^2.0.0-alpha"
  }
}
